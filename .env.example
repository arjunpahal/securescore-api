# Copy this file to .env and adjust for your environment.
# Never commit a real .env — it is listed in .gitignore.

NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securescore
DB_USER=securescore
DB_PASSWORD=securescore_dev_password
DB_POOL_MAX=10

# --- Authentication ---------------------------------------------------------
# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# --- CORS -------------------------------------------------------------------
CORS_ORIGIN=*

# --- Docker Compose ports ---------------------------------------------------
API_PORT=3000
PROD_API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
