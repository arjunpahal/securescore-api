{
  "name": "securescore-api",
  "version": "1.0.0",
  "description": "SecureScore - Automated Security Health Dashboard API for Deakin Capstone projects",
  "main": "src/server.js",
  "author": "Arjun Pahal <s225634444@deakin.edu.au>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit --coverage --forceExit",
    "test:integration": "jest tests/integration --forceExit --detectOpenHandles --runInBand",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit --forceExit",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "audit:security": "npm audit --audit-level=moderate --json > security-audit.json || true"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pino": "^8.20.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testTimeout": 15000
  },
  "jest-junit": {
    "outputDirectory": "./test-results",
    "outputName": "junit.xml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arjunpahal/securescore-api.git"
  },
  "keywords": [
    "security",
    "devops",
    "cicd",
    "jenkins",
    "vulnerability-scanning"
  ]
}
